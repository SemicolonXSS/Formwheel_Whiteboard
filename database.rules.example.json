{
  "rules": {
    "whiteboardRooms": {
      "$room": {
        ".read": "auth != null && root.child('whiteboardRooms').child($room).child('meta').exists()",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('owner').val() === auth.uid && $room.matches(/^[A-Z0-9]{6}$/)",
          ".validate": "newData.hasChildren(['owner','createdAt'])",
          "owner": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('whiteboardRooms').child($room).child('meta').exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['name','joinedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 24)",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "actions": {
          ".write": "auth != null && auth.uid === root.child('whiteboardRooms').child($room).child('meta').child('owner').val() && !newData.exists()",
          "$action": {
            ".write": "auth != null && root.child('whiteboardRooms').child($room).child('meta').exists() && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "!newData.exists() || (newData.hasChildren(['uid','tool','color','width','fill','points','createdAt']) && newData.child('uid').val() === auth.uid && newData.child('width').isNumber() && newData.child('width').val() >= 1 && newData.child('width').val() <= 50 && newData.child('points').childrenCount <= 1500)",
            "uid": {".validate": "newData.val() === auth.uid"},
            "tool": {".validate": "newData.val() === 'pen' || newData.val() === 'eraser' || newData.val() === 'line' || newData.val() === 'rect' || newData.val() === 'ellipse'"},
            "color": {".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"},
            "width": {".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"},
            "fill": {".validate": "newData.isBoolean()"},
            "points": {".validate": "newData.hasChildren() && newData.childrenCount <= 1500"},
            "createdAt": {".validate": "newData.isNumber()"},
            "$other": {".validate": false}
          }
        }
      }
    }
  }
}